{
  "name": "claude-usage",
  "displayName": "Claude Usage",
  "description": "Shows Claude 5-hour and weekly usage limits for multiple accounts.",
  "version": "0.1.0",
  "publisher": "local",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "claudeUsage", "title": "Claude Usage", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "claudeUsage": [
        { "type": "webview", "id": "claudeUsage.panel", "name": "Usage Limits" }
      ]
    },
    "commands": [
      { "command": "claudeUsage.refresh", "title": "Refresh", "category": "Claude Usage", "icon": "$(refresh)" },
      { "command": "claudeUsage.addAccount", "title": "Add Account", "category": "Claude Usage", "icon": "$(add)" },
      { "command": "claudeUsage.removeAccount", "title": "Remove Account", "category": "Claude Usage" },
      { "command": "claudeUsage.showPanel", "title": "Show Usage Panel", "category": "Claude Usage" }
    ],
    "menus": {
      "view/title": [
        { "command": "claudeUsage.refresh", "when": "view == claudeUsage.panel", "group": "navigation@1" },
        { "command": "claudeUsage.addAccount", "when": "view == claudeUsage.panel", "group": "navigation@2" }
      ]
    },
    "configuration": {
      "title": "Claude Usage",
      "properties": {
        "claudeUsage.accounts": {
          "type": "array",
          "default": [],
          "markdownDescription": "Claude Code config directories to track (in addition to auto-discovered ones). Each profile is a directory used as `CLAUDE_CONFIG_DIR`.",
          "items": {
            "type": "object",
            "required": ["configDir"],
            "properties": {
              "name": { "type": "string", "description": "Display name." },
              "configDir": { "type": "string", "description": "Path to the Claude Code config directory, e.g. ~/.claude-work." },
              "keychainService": { "type": "string", "description": "macOS only: override the Keychain service name holding this profile's credentials." }
            }
          }
        },
        "claudeUsage.autoDiscover": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Automatically track `~/.claude` and `~/.claude-*` config directories."
        },
        "claudeUsage.excludeDirs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Auto-discovered config directories to ignore."
        },
        "claudeUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 60,
          "description": "How often to poll usage, in seconds."
        },
        "claudeUsage.statusBar": {
          "type": "string",
          "enum": ["all", "highest", "off"],
          "enumDescriptions": [
            "Show 5-hour and weekly usage for every account.",
            "Show only the account closest to a limit.",
            "Hide the status bar item."
          ],
          "default": "all"
        },
        "claudeUsage.warningThreshold": { "type": "number", "default": 75, "description": "Percent at which usage is highlighted as a warning." },
        "claudeUsage.dangerThreshold": { "type": "number", "default": 90, "description": "Percent at which usage is highlighted as critical." }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies --skip-license --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
